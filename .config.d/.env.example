# ── 🌐 Langue / Language ──────────────────────
# Langue du bot : en (défaut) ou fr. Surchargeable par --lang=xx au lancement.
# BOT_LANGUAGE=en

# ── 🤖 Discord ────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_OWNER_ID=YOUR_DISCORD_OWNER_ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# ── 🎛️ Provider (type de serveur piloté) ──────
# Identifiant technique (défaut : yorkhost).
# PROVIDER=yorkhost
# Optionnel : surcharge l'URL de base par défaut du provider.
# PROVIDER_API_URL=
# Optionnel : timeout des lectures d'état en millisecondes
# (défaut : celui du provider — 60 s pour yorkhost). Surcharge utile si le
# panneau est plus lent que la normale.
# PROVIDER_GET_TIMEOUT_MS=60000
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY
#
# PROVIDER=generic : pilote n'importe quel panneau à API REST, configuré ici :
#   PROVIDER_API_URL=https://panel.example.com/api   (obligatoire)
#   PROVIDER_AUTH_HEADER=X-API-Key                   (défaut : Authorization)
#   PROVIDER_AUTH_VALUE="Bearer {key}"              (défaut : "{key}")
#   PROVIDER_STATUS_PATH=/services/{id}              (défaut)
#   PROVIDER_POWER_PATH=/services/{id}/power         (défaut, {action} remplacé)
#   PROVIDER_POWER_METHOD=POST                       (POST ou GET)
#   PROVIDER_POWER_BODY={"action":"{action}"}        (vide = pas de corps)
#   PROVIDER_STATUS_UNWRAP=data                      (clés à descendre, virgules)
#   PROVIDER_STATE_RUNNING=running,online            (valeurs « démarré »)
#   PROVIDER_STATE_STOPPED=stopped,offline           (valeurs « arrêté »)

# ── 🎮 Services (cibles pilotées) ──────────────
# Mode mono-cible : un seul ID ici.
PROVIDER_SERVICE_ID=YOUR_PROVIDER_SERVICE_ID
# Mode multi-cibles : alias=id séparés par des virgules.
# Si défini, remplace PROVIDER_SERVICE_ID. Chaque alias devient un choix dans les commandes.
# L'alias sert aussi de PSEUDONYME : le nom transmis par l'API du provider est
# prioritaire à l'affichage (dashboard, alertes, confirmations), sinon l'alias est utilisé.
# Exemple : renommer son serveur → PROVIDER_SERVICES=mon-serveur=svc-abc
# PROVIDER_SERVICES=main=svc-abc,survival=svc-def

# ── 🔔 Watchdog (optionnel) ────────────────────
# ID du salon Discord où envoyer les alertes automatiques. Si absent → watchdog désactivé.
# DISCORD_ALERT_CHANNEL_ID=YOUR_ALERT_CHANNEL_ID
# Intervalle entre deux scans du watchdog en millisecondes (défaut : 60000).
# ALERT_INTERVAL_MS=60000
